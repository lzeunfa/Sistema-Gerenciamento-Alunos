# Senhas do ambiente Docker. Copie para docker/.env e troque os valores (nunca commite o docker/.env).
#   cp docker/.env.example docker/.env
# Regras do SQL Server: minimo 8 caracteres, com maiusculas, minusculas, numeros e simbolos. Sem aspas.
# Para gerar uma senha forte no Debian:  openssl rand -base64 24

# administrador do SQL Server (so os scripts de instalacao usam)
SA_PASSWORD=Troque-Esta-Senha-SA-1

# usuario do sistema no banco (gkt_app, so le e grava dados)
DB_PASSWORD=Troque-Esta-Senha-App-2

# porta do sistema no seu computador: http://127.0.0.1:8080
PORTA_APP=8080
