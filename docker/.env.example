# Senhas do ambiente Docker. Copie para docker/.env e PREENCHA (nunca commite o docker/.env).
#   cp docker/.env.example docker/.env
# Ficam em branco de proposito: o docker compose se recusa a subir enquanto nao forem preenchidas.
# Regras do SQL Server: minimo 8 caracteres, com maiusculas, minusculas, numeros e simbolos. Sem aspas nem $.
# Para gerar senhas fortes no Debian:  openssl rand -base64 18

# administrador do SQL Server (so os scripts de instalacao usam)
SA_PASSWORD=

# usuario do sistema no banco (gkt_app, so le e grava dados)
DB_PASSWORD=

# porta HTTPS do sistema no seu computador: https://127.0.0.1:8443
PORTA_APP=8443

# IP do servidor na rede da academia (opcional), incluido no certificado HTTPS autoassinado. Ex.: 192.168.1.23
GKT_CERT_IP=
